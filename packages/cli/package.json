{
  "name": "figloom-verify",
  "version": "0.0.3",
  "description": "CLI-first Figma-to-web and web-to-web visual verification with stable capture and artifact-based done gates.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungify/figloom.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hungify/figloom/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/hungify/figloom/issues"
  },
  "keywords": [
    "cli",
    "figma",
    "playwright",
    "screenshot",
    "visual-regression",
    "visual-testing"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "figloom": "bin/figloom.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "dist/dashboard",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "build:ui": "pnpm --filter @figloom/dashboard build",
    "pretest": "pnpm run build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build:ui && pnpm run typecheck && pnpm test",
    "verify": "tsx src/cli.ts verify",
    "done-gate": "tsx src/cli.ts done-gate"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@figloom/contracts": "workspace:*",
    "@figloom/verify": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "commander": "^15.0.0",
    "hono": "4.12.32",
    "open": "^11.0.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
